# ============================================
# SPENDLYTIC AI - Environment Variables
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Get your Neon database URL from: https://neon.tech
# 
# ⚠️ SECURITY NOTE: Currently uses NEXT_PUBLIC_ prefix because client 
# components access the database directly. This is NOT ideal for production.
# 
# TODO: Refactor to use API routes for database operations to improve security.
# For now, ensure your database has proper row-level security configured.
NEXT_PUBLIC_DATABASE_URL=postgresql://user:password@host/database

# ============================================
# AUTHENTICATION (CLERK)
# ============================================
# Get your keys from: https://clerk.com
# The publishable key is safe to expose (used in browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# The secret key should NEVER be exposed (server-side only)
CLERK_SECRET_KEY=sk_test_xxxxx

# ============================================
# AI INTEGRATION (GEMINI)
# ============================================
# Get your API key from: https://ai.google.dev
# ✅ SECURE: This is now used only in server-side API routes
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# QUICK SETUP GUIDE
# ============================================
# 1. Copy this file to `.env.local`:
#    cp .env.example .env.local
#
# 2. Fill in all the values above with your actual credentials
#
# 3. Never commit `.env.local` to git (it's in .gitignore)
#
# 4. Restart your development server after making changes:
#    npm run dev
# ============================================
